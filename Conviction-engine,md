name: CI
on:
  push:         { branches: [main] }
  pull_request: { branches: [main] }

jobs:
  quality:
    name: Lint · Type Check · Build
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: pnpm/action-setup@v4
        with: { version: 9 }
      - uses: actions/setup-node@v4
        with: { node-version: 20, cache: pnpm }
      - run: pnpm install --frozen-lockfile
      - run: pnpm lint
      - run: pnpm exec tsc --noEmit
      - run: pnpm build
      - uses: actions/upload-artifact@v4
        with: { name: nextjs-build, path: .next/, retention-days: 1 }

  content-audit:
    name: Content Audit — Zero Violations
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: No unicode escapes
        run: grep -rn "\\\\u2192" --include="*.tsx" --include="*.ts" --include="*.mdx" . && exit 1 || exit 0
      - name: No 24/7
        run: grep -rniE "\b24/7\b" --include="*.tsx" --include="*.mdx" . && exit 1 || exit 0
      - name: No first-person identity claims
        run: grep -rniE "\b(I (built|created|designed|developed|made|led|wrote|shipped))\b" --include="*.tsx" --include="*.mdx" --exclude-dir={node_modules,.next} . && exit 1 || exit 0
      - name: No unresolved placeholders
        run: grep -rn "REPLACE_BEFORE_COMMIT" --include="*.ts" --include="*.tsx" --exclude-dir=node_modules . && exit 1 || exit 0
      - name: No legacy ESLint configs
        run: find . -maxdepth 3 -name ".eslintrc*" -not -path "*/node_modules/*" | grep . && exit 1 || exit 0

  e2e:
    name: E2E Tests
    runs-on: ubuntu-latest
    needs: quality
    steps:
      - uses: actions/checkout@v4
      - uses: pnpm/action-setup@v4
        with: { version: 9 }
      - uses: actions/setup-node@v4
        with: { node-version: 20, cache: pnpm }
      - run: pnpm install --frozen-lockfile
      - run: pnpm exec playwright install --with-deps chromium
      - run: pnpm build
      - run: pnpm exec playwright test --project=chromium
      - uses: actions/upload-artifact@v4
        if: always()
        with: { name: playwright-report, path: playwright-report/, retention-days: 7 }

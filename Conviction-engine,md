"use client";
import { useEffect, useRef, useState, useCallback } from "react";
import { motion, AnimatePresence } from "framer-motion";
import { useRouter }               from "next/navigation";
import { useReducedMotion }        from "@/hooks/useReducedMotion";
import { springConfig }            from "@/lib/motion";

interface Command { id: string; label: string; shortcut?: string; action: () => void; }

export function CommandPalette() {
  const [open,   setOpen]   = useState(false);
  const [query,  setQuery]  = useState("");
  const [active, setActive] = useState(0);
  const inputRef = useRef<HTMLInputElement>(null);
  const router   = useRouter();
  const reduced  = useReducedMotion();

  const commands: Command[] = [
    { id: "projects", label: "Go to Projects", action: () => document.getElementById("projects")?.scrollIntoView({ behavior: "smooth" }) },
    { id: "about",    label: "Go to About",    action: () => document.getElementById("about")?.scrollIntoView({ behavior: "smooth" }) },
    { id: "writing",  label: "Go to Writing",  action: () => document.getElementById("writing")?.scrollIntoView({ behavior: "smooth" }) },
    { id: "contact",  label: "Go to Contact",  action: () => document.getElementById("contact")?.scrollIntoView({ behavior: "smooth" }) },
    { id: "sabiscore",   label: "Open SabiScore case study",   action: () => router.push("/work/sabiscore") },
    { id: "hashablanca", label: "Open Hashablanca case study", action: () => router.push("/work/hashablanca") },
    { id: "all-writing", label: "All writing",                 action: () => router.push("/writing") },
    { id: "resume",  label: "Download resume", shortcut: "R", action: () => window.open("/oscar-scardubu-resume.pdf", "_blank") },
    { id: "email",   label: "Send email",      shortcut: "E", action: () => window.open("mailto:oscar@scardubu.dev") },
  ];

  const filtered = query.trim()
    ? commands.filter(c => c.label.toLowerCase().includes(query.toLowerCase()))
    : commands;

  const exec = useCallback((cmd: Command) => {
    cmd.action(); setOpen(false); setQuery(""); setActive(0);
  }, []);

  useEffect(() => {
    const onKey = (e: KeyboardEvent) => {
      if ((e.metaKey || e.ctrlKey) && e.key === "k") { e.preventDefault(); setOpen(o => !o); }
      if (!open) return;
      if (e.key === "Escape")    { setOpen(false); setQuery(""); }
      if (e.key === "ArrowDown") { e.preventDefault(); setActive(a => Math.min(a + 1, filtered.length - 1)); }
      if (e.key === "ArrowUp")   { e.preventDefault(); setActive(a => Math.max(a - 1, 0)); }
      if (e.key === "Enter" && filtered[active]) exec(filtered[active]);
    };
    window.addEventListener("keydown", onKey);
    return () => window.removeEventListener("keydown", onKey);
  }, [open, active, filtered, exec]);

  useEffect(() => { if (open) setTimeout(() => inputRef.current?.focus(), 50); }, [open]);
  useEffect(() => { setActive(0); }, [query]);

  return (
    <AnimatePresence>
      {open && (
        <motion.div className="cmd-overlay"
          initial={reduced ? {} : { opacity: 0 }} animate={{ opacity: 1 }} exit={reduced ? {} : { opacity: 0 }}
          onClick={() => { setOpen(false); setQuery(""); }}
          aria-modal="true" role="dialog" aria-label="Command palette">
          <motion.div className="cmd-panel glass glass-full"
            initial={reduced ? {} : { opacity: 0, y: -12, scale: 0.97 }}
            animate={{ opacity: 1, y: 0, scale: 1 }}
            exit={reduced ? {} : { opacity: 0, y: -8, scale: 0.97 }}
            transition={springConfig}
            onClick={e => e.stopPropagation()}>
            <input ref={inputRef} className="cmd-input" placeholder="Search or jump to…"
              value={query} onChange={e => setQuery(e.target.value)}
              aria-label="Command search" autoComplete="off" />
            <div role="listbox" aria-label="Commands">
              {filtered.length === 0 && (
                <div className="cmd-item" style={{ color: "var(--color-text-muted)" }}>No results for "{query}"</div>
              )}
              {filtered.map((cmd, i) => (
                <div key={cmd.id} className="cmd-item" role="option" aria-selected={i === active}
                  data-active={i === active} onClick={() => exec(cmd)} onMouseEnter={() => setActive(i)}>
                  {cmd.label}
                  {cmd.shortcut && <kbd>{cmd.shortcut}</kbd>}
                </div>
              ))}
            </div>
          </motion.div>
        </motion.div>
      )}
    </AnimatePresence>
  );
}

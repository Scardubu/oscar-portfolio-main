@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration:        0.01ms !important;
    animation-iteration-count: 1      !important;
    transition-duration:       0.01ms !important;
    scroll-behavior:           auto   !important;
  }
}

*, *::before, *::after {
  box-sizing: border-box;
  margin: 0; padding: 0;
  border: 0 solid var(--color-border);
}

html {
  scroll-behavior: smooth;
  font-feature-settings: "kern" 1, "liga" 1, "calt" 1;
  -webkit-text-size-adjust: 100%;
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  color-scheme: dark light;
}

body {
  font-family:      var(--font-sans);
  font-size:        var(--text-base);
  font-weight:      var(--weight-regular);
  line-height:      var(--leading-normal);
  color:            var(--color-text-primary);
  background-color: var(--color-bg);
  min-height: 100vh;
  overflow-x: hidden;
  transition: background-color var(--dur-base) var(--ease-out),
              color var(--dur-base) var(--ease-out);
}

h1 {
  font-family:    var(--font-display);
  font-size:      var(--text-4xl);
  font-weight:    var(--weight-bold);
  line-height:    var(--leading-tight);
  letter-spacing: var(--tracking-tight);
  overflow-wrap:  break-word;
}
h2 {
  font-family:    var(--font-display);
  font-size:      var(--text-3xl);
  font-weight:    var(--weight-semibold);
  line-height:    var(--leading-tight);
  letter-spacing: var(--tracking-snug);
}
h3 {
  font-family:    var(--font-display);
  font-size:      var(--text-xl);
  font-weight:    var(--weight-semibold);
  line-height:    var(--leading-snug);
  letter-spacing: var(--tracking-snug);
}
h4 {
  font-family: var(--font-sans);
  font-size:   var(--text-lg);
  font-weight: var(--weight-medium);
  line-height: var(--leading-snug);
}
h5, h6 {
  font-family:    var(--font-sans);
  font-size:      var(--text-base);
  font-weight:    var(--weight-medium);
  letter-spacing: var(--tracking-wide);
  text-transform: uppercase;
  color: var(--color-text-muted);
}
p {
  line-height: var(--leading-normal);
  color:       var(--color-text-secondary);
  max-width:   var(--max-width-prose);
}

.label {
  display:        block;
  font-size:      var(--text-xs);
  font-weight:    var(--weight-medium);
  letter-spacing: var(--tracking-widest);
  text-transform: uppercase;
  color:          var(--color-text-muted);
}

code, pre, kbd, samp { font-family: var(--font-mono); font-size: 0.875em; }
code:not(pre code) {
  background:    var(--color-surface-raised);
  border:        1px solid var(--color-border);
  border-radius: var(--radius-xs);
  padding:       0.15em 0.4em;
  font-size:     var(--text-sm);
  color:         var(--color-cyan);
}

a {
  color:           inherit;
  text-decoration: none;
  transition:      color var(--dur-fast) var(--ease-out);
}

:focus-visible {
  outline:        2px solid var(--color-accent);
  outline-offset: 3px;
  border-radius:  var(--radius-xs);
}

.skip-nav {
  position:      absolute;
  top:  var(--space-4);
  left: var(--space-4);
  z-index: 200;
  padding:       var(--space-3) var(--space-6);
  background:    var(--color-accent);
  color:         #fff;
  font-size:     var(--text-sm);
  font-weight:   var(--weight-medium);
  border-radius: var(--radius-md);
  transform:     translateY(-150%);
  transition:    transform var(--dur-fast) var(--ease-out);
}
.skip-nav:focus-visible { transform: translateY(0); }

[id] { scroll-margin-top: calc(var(--nav-height) + var(--space-4)); }

.container {
  width:     100%;
  max-width: var(--max-width);
  margin:    0 auto;
  padding:   0 var(--space-4);
}
@media (min-width: 640px)  { .container { padding: 0 var(--space-8);  } }
@media (min-width: 1024px) { .container { padding: 0 var(--space-12); } }

section {
  padding-top:    var(--section-gap-mid);
  padding-bottom: var(--section-gap-mid);
}

.prose {
  max-width:   var(--max-width-prose);
  color:       var(--color-text-secondary);
  line-height: var(--leading-loose);
}
.prose h2 { margin-top: var(--space-12); margin-bottom: var(--space-4); font-size: var(--text-2xl); }
.prose h3 { margin-top: var(--space-8);  margin-bottom: var(--space-3); font-size: var(--text-xl); }
.prose p  { margin-bottom: var(--space-6); }
.prose ul, .prose ol { margin-bottom: var(--space-6); padding-left: var(--space-6); }
.prose li { margin-bottom: var(--space-2); }
.prose blockquote {
  border-left: 2px solid var(--color-accent);
  padding-left: var(--space-6);
  margin: var(--space-8) 0;
  font-style: italic;
  color: var(--color-text-secondary);
}
.prose hr {
  border: none;
  border-top: 1px solid var(--color-border);
  margin: var(--space-12) 0;
}
.prose pre {
  background:    var(--color-surface-raised);
  border:        1px solid var(--color-border);
  border-radius: var(--radius-md);
  padding:       var(--space-6);
  overflow-x:    auto;
  margin:        var(--space-6) 0;
  font-size:     var(--text-sm);
}
.prose a {
  color: var(--color-cyan);
  text-decoration: underline;
  text-underline-offset: 3px;
  text-decoration-color: rgba(34,211,238,0.3);
}
.prose a:hover { text-decoration-color: var(--color-cyan); }
.prose img {
  border-radius: var(--radius-lg);
  border: 1px solid var(--color-border);
  max-width: 100%;
}

.glass {
  background: var(--glass-bg);
  backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-sat));
  -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-sat));
  box-shadow: var(--glass-shadow);
  will-change: transform;
  transform: translateZ(0);
  position: relative;
  overflow: hidden;
  transition: background var(--dur-base) var(--ease-out),
              box-shadow  var(--dur-base) var(--ease-out);
}

.glass-full   { backdrop-filter: blur(20px) saturate(180%); -webkit-backdrop-filter: blur(20px) saturate(180%); }
.glass-medium { backdrop-filter: blur(16px) saturate(160%); -webkit-backdrop-filter: blur(16px) saturate(160%); }
.glass-light  {
  backdrop-filter: blur(8px) saturate(140%);
  -webkit-backdrop-filter: blur(8px) saturate(140%);
  background: rgba(255,255,255,0.03);
}

.glass-full {
  border-top:    1px solid var(--fresnel-top);
  border-left:   1px solid var(--fresnel-left);
  border-right:  1px solid var(--fresnel-right);
  border-bottom: 1px solid var(--fresnel-bottom);
}
.glass-medium { border: 1px solid var(--glass-border); }
.glass-light  { border: 1px solid var(--color-border-subtle); }

@property --glass-thickness { syntax: "<length>"; initial-value: 1px; inherits: false; }
.glass-full {
  --glass-thickness: 1px;
  box-shadow: var(--glass-shadow), 0 0 0 var(--glass-thickness) rgba(255,255,255,0.07) inset;
  transition: --glass-thickness 0.2s ease, box-shadow var(--dur-base) var(--ease-out);
}
.glass-full:hover {
  --glass-thickness: 2px;
  box-shadow:
    0 0 0 var(--glass-thickness) rgba(255,255,255,0.12) inset,
    0 20px 60px rgba(0,0,0,0.42),
    0 0 40px rgba(34,211,238,0.05);
}

.glass::before {
  content: "";
  position: absolute; inset: 0;
  background: var(--glass-refraction);
  pointer-events: none;
  border-radius: inherit;
  opacity: 0.5;
  transition: opacity var(--dur-base) var(--ease-out);
}

@keyframes shimmer {
  from { background-position: -200% center; }
  to   { background-position:  200% center; }
}
.glass::after {
  content: "";
  position: absolute; inset: 0;
  background: linear-gradient(105deg, transparent 40%, rgba(255,255,255,0.05) 50%, transparent 60%);
  background-size: 200% 100%;
  animation: shimmer 1.4s ease-in-out forwards;
  pointer-events: none;
  border-radius: inherit;
  will-change: background-position;
}

.glass-chromatic {
  box-shadow:
    var(--glass-shadow),
     1px  1px 0 rgba(255,80,80,0.025),
    -1px -1px 0 rgba(34,211,238,0.035);
}

.glass-card {
  border-radius: var(--radius-lg);
  padding: var(--space-6);
}
.glass-card:hover { background: var(--glass-bg-hover); box-shadow: var(--glass-shadow-hover); }
.glass-card:hover::before { opacity: 0.9; }

.glass-nav {
  background: rgba(9,9,14,0.72);
  backdrop-filter: blur(24px) saturate(180%);
  -webkit-backdrop-filter: blur(24px) saturate(180%);
  border-bottom: 1px solid var(--color-border);
}
[data-theme="light"] .glass-nav { background: rgba(245,245,250,0.82); }

.metric-card {
  background:    var(--glass-bg);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border:        1px solid var(--glass-border);
  border-radius: var(--radius-md);
  transition:
    border-color var(--dur-base) var(--ease-out),
    box-shadow   var(--dur-base) var(--ease-out);
}
.metric-card:hover {
  border-color: var(--color-accent);
  box-shadow: 0 0 0 1px var(--color-accent), 0 0 20px var(--color-accent-glow);
}

@keyframes metric-breath {
  0%, 100% { transform: scale(1) translateZ(0); }
  50%       { transform: scale(1.018) translateZ(0); }
}
.metric-breath { animation: metric-breath 3s ease-in-out infinite; }

.bento-featured { grid-column: span 2; grid-row: span 2; }
.bento-side     { grid-column: span 1; grid-row: span 1; }
.bento-full     { grid-column: 1 / -1; }
@media (max-width: 639px) {
  .bento-featured, .bento-side, .bento-full { grid-column: 1 / -1; grid-row: span 1; }
}
@media (min-width: 640px) and (max-width: 1023px) {
  .bento-featured { grid-column: span 2; grid-row: span 1; }
}

[data-reveal] {
  opacity: 0;
  transform: translateY(18px) translateZ(0);
  transition:
    opacity   var(--dur-slow) var(--ease-out),
    transform var(--dur-slow) var(--ease-out);
}
[data-reveal].revealed     { opacity: 1; transform: translateY(0) translateZ(0); }
[data-reveal-delay="1"]    { transition-delay: 80ms;  }
[data-reveal-delay="2"]    { transition-delay: 160ms; }
[data-reveal-delay="3"]    { transition-delay: 240ms; }
[data-reveal-delay="4"]    { transition-delay: 320ms; }

.reading-progress {
  position: fixed;
  top: 0; left: 0;
  height: 2px;
  width: var(--progress, 0%);
  background: var(--color-accent);
  z-index: 200;
  will-change: width;
  transform: translateZ(0);
  transition: width 50ms linear;
  pointer-events: none;
}

@keyframes pulse-dot {
  0%, 100% { opacity: 1; transform: scale(1) translateZ(0); }
  50%       { opacity: 0.5; transform: scale(1.5) translateZ(0); }
}
.live-dot {
  display:       inline-block;

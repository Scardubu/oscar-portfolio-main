{
  "name": "oscar-portfolio",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "prepare": "node -e \"if (process.env.CI || process.env.VERCEL) process.exit(0); require('child_process').execSync('pnpm exec husky', { stdio: 'inherit' })\"",
    "lint": "eslint \"app/**/*.{ts,tsx}\" \"components/**/*.{ts,tsx}\" \"hooks/**/*.{ts,tsx}\" \"lib/**/*.{ts,tsx}\" \"constants/**/*.ts\" \"scripts/**/*.ts\" \"e2e/**/*.ts\" \"tests/**/*.ts\" \"*.{ts,mjs}\"",
    "lint:fix": "eslint \"app/**/*.{ts,tsx}\" \"components/**/*.{ts,tsx}\" \"hooks/**/*.{ts,tsx}\" \"lib/**/*.{ts,tsx}\" \"constants/**/*.ts\" \"scripts/**/*.ts\" \"e2e/**/*.ts\" \"tests/**/*.ts\" \"*.{ts,mjs}\" --fix",
    "lint:staged": "lint-staged",
    "precommit:scan": "tsx scripts/conviction-scan.ts",
    "type-check": "tsc --project tsconfig.typecheck.json --noEmit",
    "analyze": "ANALYZE=true next build",
    "test": "pnpm build && playwright test",
    "test:smoke": "pnpm build && playwright test e2e/smoke.spec.ts tests/e2e/smoke.spec.ts tests/e2e/user-journey.spec.ts --project=chromium --workers=1",
    "test:a11y": "pnpm build && playwright test e2e/smoke.spec.ts --project=chromium --grep \"accessibility\" --workers=1",
    "test:unit": "vitest run",
    "test:e2e": "pnpm build && playwright test --project=chromium",
    "test:mobile": "pnpm build && playwright test --project=mobile-chrome --project=mobile-safari",
    "test:all": "pnpm build && playwright test",
    "audit:copy": "node scripts/audit-copy.mjs --strict-nrs",
    "lhci": "lhci autorun"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs}": [
      "eslint --fix"
    ]
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.1",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^15.5.10",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-select": "^2.1.4",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-tooltip": "^1.1.6",
    "@vercel/analytics": "^2.0.1",
    "@vercel/og": "^0.11.1",
    "@vercel/speed-insights": "^2.0.0",
    "chart.js": "^4.5.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3": "^7.9.0",
    "framer-motion": "11.18.0",
    "fuse.js": "^7.3.0",
    "gray-matter": "^4.0.3",
    "gsap": "^3.15.0",
    "lenis": "^1.3.23",
    "lucide-react": "^0.475.0",
    "next": "15.5.10",
    "next-mdx-remote": "^6.0.0",
    "react": "19.0.0",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "19.0.0",
    "react-hook-form": "^7.54.2",
    "react-hot-toast": "^2.6.0",
    "reading-time": "^1.5.0",
    "rehype-pretty-code": "^0.14.3",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.9.4",
    "schema-dts": "^2.0.0",
    "shiki": "^4.0.2",
    "sonner": "^1.7.1",
    "swr": "^2.4.1",
    "tailwind-merge": "^3.5.0",
    "three": "^0.184.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@next/bundle-analyzer": "^15.5.10",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/d3": "^7.4.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.21",
    "axe-core": "^4.11.4",
    "critters": "0.0.24",
    "eslint": "^9.0.0",
    "eslint-config-next": "15.5.10",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "globals": "17.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.4.0",
    "prettier-plugin-tailwindcss": "^0.6.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.4",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.58.2",
    "vitest": "^3.2.1"
  },
  "engines": {
    "node": ">=20.0.0 <24.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0"
}

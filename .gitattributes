# Force LF line endings for all text files
* text=auto eol=lf

# Explicitly set LF for source files
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.css text eol=lf
*.json text eol=lf
*.md text eol=lf
*.mdx text eol=lf
*.mjs text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.sh text eol=lf

# Binary files - never convert
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.avif binary
*.woff2 binary
*.woff binary
*.ttf binary
*.eot binary
*.pdf binary
